tsClient\nfrom huggingface_hub import login\n\nlogin(token=UserSecretsClient().get_secret(\"HF_TOKEN\"))\n\nREPO_NAME = \"vijay5799760/Qwen2.5-3B-SEntFiN-LoRA\"\n\nprint(f\"Pushing to {REPO_NAME} ...\")\nmodel.push_to_hub(REPO_NAME, private=True)\ntok.push_to_hub(REPO_NAME, private=True)\n\nprint(f\"✅ Saved → https://huggingface.co/{REPO_NAME}\")\n\n# Cleanup after push\ndel model, tok, base\ngc.collect(); torch.cuda.empty_cache()\nprint(\"✅ GPU cleared\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-03T19:04:27.058000Z","iopub.execute_input":"2026-08-03T19:04:27.058434Z","iopub.status.idle":"2026-08-03T19:04:30.892900Z","shell.execute_reply.started":"2026-08-03T19:04:27.058404Z","shell.execute_reply":"2026-08-03T19:04:30.892167Z"}},"outputs":[{"name":"stdout","text":"Pushing to vijay5799760/Qwen2.5-3B-SEntFiN-LoRA ...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Processing Files (0 / 0): |          |  0.00B /  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d57ca16a8112491088a79a8868e1f77d"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"New Data Upload: |          |  0.00B /  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"39577443c1144a829d753a166e053795"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"README.md: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"92586f95230641608c97b8be4c482cda"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Processing Files (0 / 0): |          |  0.00B /  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8b2f9ea1cf734a80984705ac518d29a6"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"New Data Upload: |          |  0.00B /  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"39c35b02200d48f58f9be7fc5adb63f8"}},"metadata":{}},{"name":"stdout","text":"✅ Saved → https://huggingface.co/vijay5799760/Qwen2.5-3B-SEntFiN-LoRA\n✅ GPU cleared\n","output_type":"stream"}],"execution_count":24},{"id":"6805e187-70bc-40f1-8ec1-6055a7cd6550","cell_type":"code","source":"# ── Reload Qwen2.5-3B adapter + Blind Spot Test ───────────────────────\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\nfrom peft import PeftModel\nimport torch\n\nADAPTER_PATH = \"/kaggle/working/Qwen2.5-3B_adapter\"\nBASE_MODEL   = \"Qwen/Qwen2.5-3B-Instruct\"\n\nprint(\"Loading Qwen2.5-3B adapter from disk...\")\ntok  = AutoTokenizer.from_pretrained(ADAPTER_PATH)\nbase = AutoModelForCausalLM.from_pretrained(\n    BASE_MODEL, torch_dtype=torch.float16, device_map=\"auto\"\n)\nmodel = PeftModel.from_pretrained(base, ADAPTER_PATH)\nmodel.eval()\ntok.padding_side = \"left\"\nprint(\"✅ Adapter loaded\")\n\n# ── Blind Spot Headlines ───────────────────────────────────────────────\nBLIND_SPOT_HEADLINES = [\n\n    # ── Corporate Expansions (FinBERT classic failures) ───────────────\n    (\"TCS opens industrial AI lab in Bengaluru in partnership with Nvidia\",    \"positive/neutral\"),\n    (\"Infosys expands operations to 3 new cities across Southeast Asia\",       \"positive/neutral\"),\n    (\"Wipro opens new delivery centre in Hyderabad creating 2000 jobs\",        \"positive/neutral\"),\n    (\"Company invests 500 crore in new manufacturing facility in Pune\",        \"positive/neutral\"),\n    (\"Reliance opens largest retail store in Mumbai\",                           \"positive/neutral\"),\n\n    # ── Partnerships & Contracts ──────────────────────────────────────\n    (\"TCS partners with Nvidia to build enterprise AI solutions\",              \"positive/neutral\"),\n    (\"Infosys wins new contract worth 500 crore from US banking client\",       \"positive\"),\n    (\"HCL Technologies signs 5-year deal with European aerospace company\",     \"positive\"),\n    (\"Wipro bags cloud transformation deal worth 300 million dollars\",         \"positive\"),\n    (\"Tata Motors partners with Toyota for EV platform development\",           \"positive/neutral\"),\n\n    # ── Product Launches ──────────────────────────────────────────────\n    (\"Company launches new AI-powered product line targeting SMBs\",            \"positive/neutral\"),\n    (\"Bajaj Auto unveils new electric scooter with 150km range\",               \"positive/neutral\"),\n    (\"HDFC Bank introduces new digital lending platform for MSMEs\",            \"positive/neutral\"),\n\n    # ── Leadership & Hiring ───────────────────────────────────────────\n    (\"Infosys appoints new Chief Technology Officer from Google\",              \"positive/neutral\"),\n    (\"Company hires 10000 fresh graduates across engineering campuses\",        \"positive/neutral\"),\n\n    # ── Controls: Clear Positives ─────────────────────────────────────\n    (\"Reliance Industries posts record quarterly profit of 20000 crore\",       \"positive\"),\n    (\"Stock rallies 8 percent after strong quarterly earnings beat\",            \"positive\"),\n    (\"Company reports highest ever revenue growth of 32 percent YoY\",          \"positive\"),\n\n    # ── Controls: Clear Negatives ─────────────────────────────────────\n    (\"Infosys cuts annual revenue forecast amid global slowdown\",               \"negative\"),\n    (\"TCS reports steep decline in net profit dragged by US market weakness\",   \"negative\"),\n]\nSYSTEM_PROMPT = (\n    \"You are a financial sentiment analyst. Given a news headline and a company name, \"\n    \"classify the sentiment towards that company. \"\n    \"Reply with exactly one word: positive, negative, or neutral.\"\n)\n\ndef test_headline(headline, entity=\"Company\"):\n    messages = [\n        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n        {\"role\": \"user\",   \"content\": f\"Headline: {headline}\\nCompany: {entity}\\nSentiment:\"}\n    ]\n    try:\n        prompt = tok.apply_chat_template(\n            messages, tokenize=False, add_generation_prompt=True\n        )\n    except Exception:\n        # Fallback if system role not supported\n        msgs = [{\"role\": \"user\",\n                 \"content\": f\"{SYSTEM_PROMPT}\\n\\nHeadline: {headline}\\nCompany: {entity}\\nSentiment:\"}]\n        prompt = tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)\n\n    inputs = tok(prompt, return_tensors=\"pt\",\n                 truncation=True, max_length=150).to(model.device)\n\n    with torch.no_grad():\n        out = model.generate(\n            **inputs, max_new_tokens=5, do_sample=False,\n            pad_token_id=tok.pad_token_id or tok.eos_token_id,\n        )\n\n    new_tokens = out[0][inputs[\"input_ids\"].shape[1]:]\n    raw = tok.decode(new_tokens, skip_special_tokens=True).lower().strip()\n\n    for lbl in [\"positive\", \"negative\", \"neutral\"]:\n        if raw.startswith(lbl) or lbl in raw:\n            return lbl, raw\n    return \"neutral\", raw\n\n# ── Run ───────────────────────────────────────────────────────────────\nprint(\"\\n\" + \"=\"*100)\nprint(\"BLIND SPOT TEST — Qwen2.5-3B (FinBERT failure cases)\")\nprint(\"=\"*100)\nprint(f\"{'':3} {'Headline':<58} {'Expected':<20} {'Predicted':<12} {'Raw'}\")\nprint(\"-\"*100)\n\npassed = 0\nfor headline, expected in BLIND_SPOT_HEADLINES:\n    pred, raw = test_headline(headline)\n    expected_labels = [e.strip() for e in expected.split(\"/\")]\n    ok = pred in expected_labels\n    if ok: passed += 1\n    flag = \"✅\" if ok else \"❌\"\n    print(f\"{flag}  {headline[:57]:<58} {expected:<20} {pred:<12} ({raw})\")\n\nprint(\"-\"*100)\nprint(f\"\\nScore: {passed}/{len(BLIND_SPOT_HEADLINES)}\")\nprint(\"✅ = correct  |  ❌ = wrong (FinBERT-style failure still present)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-03