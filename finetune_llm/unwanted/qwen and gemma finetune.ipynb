n✅ All packages ready — now Restart Kernel and Run All\n","output_type":"stream"}],"execution_count":1},{"id":"e293268c-dbde-44dd-8f49-14401ba0f90c","cell_type":"code","source":"# ── STEP 2: Imports  ──────────────────────────────────────────────────\nimport pandas as pd\nimport numpy as np\nimport json, os, time, gc, warnings\nimport torch\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score, f1_score, classification_report\nfrom datasets import Dataset\nfrom transformers import (\n    AutoTokenizer, AutoModelForCausalLM,\n    BitsAndBytesConfig, set_seed\n)\nfrom peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training, TaskType\nfrom trl import SFTTrainer, SFTConfig   # SFTConfig = correct API for TRL 1.x\n\nwarnings.filterwarnings(\"ignore\")\nset_seed(42)\n\n# HF login via Kaggle Secrets (never hardcode your token)\ntry:\n    from kaggle_secrets import UserSecretsClient\n    from huggingface_hub import login\n    login(token=\"os.environ["HF_TOKEN"]\")\n    print(\"✅ HuggingFace login OK\")\nexcept Exception as e:\n    print(f\"⚠️  HF login failed: {e}\")\n    print(\"   Fix: Kaggle → Settings → Secrets → Add secret named HF_TOKEN\")\n\nLABEL2ID = {\"positive\": 0, \"negative\": 1, \"neutral\": 2}\nCSV_PATH = '/kaggle/input/datasets/vijayadi/sentiment-stocks/SEntFiN-v1.1.csv'\nSAVE_DIR = \"/kaggle/working\"\nRESULTS  = []\n\nprint(f\"\\nGPU : {torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU'}\")\nif torch.cuda.is_available():\n    print(f\"VRAM: {torch.cuda.get_device_properties(0).total_memory/1e9:.1f} GB\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-03T13:24:51.154736Z","iopub.execute_input":"2026-08-03T13:24:51.155456Z","iopub.status.idle":"2026-08-03T13:24:55.192000Z","shell.execute_reply.started":"2026-08-03T13:24:51.155420Z","shell.execute_reply":"2026-08-03T13:24:55.191374Z"}},"outputs":[{"name":"stdout","text":"✅ HuggingFace login OK\n\nGPU : Tesla T4\nVRAM: 15.6 GB\n","output_type":"stream"}],"execution_count":2},{"id":"4accf2db-39e4-447a-bcdb-ccf685d57fd5","cell_type":"code","source":"# ── STEP 3: Data Preprocessing  ───────────────────────────────────────\ndef preprocess_data(csv_path=CSV_PATH, seed=42):\n    \"\"\"Load CSV, explode multi-entity rows, split 80/10/10.\"\"\"\n    df = pd.read_csv(csv_path)\n    rows = []\n    for _, row in df.iterrows():\n        try:\n            for entity, label in json.loads(row[\"Decisions\"]).items():\n                if label in LABEL2ID:\n                    rows.append({\n                        \"headline\": str(row[\"Title\"]).strip(),\n                        \"entity\":   str(entity).strip(),\n                        \"label\":    label\n                    })\n        except Exception:\n            continue\n\n    data = pd.DataFrame(rows)\n    print(f\"Exploded : {len(data)} samples\")\n    print(f\"Labels   : {data['label'].value_counts().to_dict()}\")\n\n    train, temp = train_test_split(\n        data, test_size=0.2, random_state=seed, stratify=data[\"label\"]\n    )\n    val, test = train_test_split(\n        temp, test_size=0.5, random_state=seed, stratify=temp[\"label\"]\n    )\n    print(f\"Train {len(train)} | Val {len(val)} | Test {len(test)}\")\n    return (\n        train.reset_index(drop=True),\n        val.reset_index(drop=True),\n        test.reset_index(drop=True)\n    )\n\ntrain_df, val_df, test_df = preprocess_data()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-03T13:24:55.192854Z","iopub.execute_input":"2026-08-03T13:24:55.193450Z","iopub.status.idle":"2026-08-03T13:24:55.805404Z","shell.execute_reply.started":"2026-08-03T13:24:55.193425Z","shell.execute_reply":"2026-08-03T13:24:55.804418Z"}},"outputs":[{"name":"stdout","text":"Exploded : 14409 samples\nLabels   : {'neutral': 5515, 'positive': 5075, 'negative': 3819}\nTrain 11527 | Val 1441 | Test 1441\n","output_type":"stream"}],"execution_count":3},{"id":"1c9fb943-af12-4490-947f-e182058a0906","cell_type":"code","source":"# ── STEP 4: Prompt helpers + Evaluation  ──────────────────────────────\nSYSTEM_PROMPT = (\n    \"You are a financial sentiment analyst. Given a news headline and a company name, \"\n    \"classify the sentiment towards that company. \"\n    \"Reply with exactly one word: positive, negative, or neutral.\"\n)\n\ndef make_training_text(headline, entity, label, tokenizer):\n    \"\"\"Full conversation text used as training signal.\"\"\"\n    messages = [\n        {\"role\": \"system\",    \"content\": SYSTEM_PROMPT},\n        {\"role\": \"user\",      \"content\": f\"Headline: {headline}\\nCompany: {entity}\\nSentiment:\"},\n        {\"role\": \"assistant\", \"content\": label}\n    ]\n    try:\n        return tokenizer.apply_chat_template(\n            messages, tokenize=False, add_generation_prompt=False\n        )\n    except Exception:\n        # Fallback: merge system into user for models that don't support system role\n        msgs = [\n            {\"role\": \"user\",      \"content\": f\"{SYSTEM_PROMPT}\\n\\nHeadline: {headline}\\nCompany: {entity}\\nSentiment:\"},\n            {\"role\": \"assistant\", \"content\": label}\n        ]\n        return tokenizer.apply_chat_template(msgs, tokenize=False, add_generation_prompt=False)\n\ndef make_inference_prompt(headline, entity, tokenizer):\n    \"\"\"Prompt for inference — no label, with generation prompt.\"\"\"\n    messages = [\n        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n        {\"role\": \"user\",   \"content\": f\"Headline: {headline}\\nCompany: {entity}\\nSentiment:\"}\n    ]\n    try:\n        return tokenizer.apply_chat_template(\n            messages, tokenize=False, add_generation_prompt=True\n        )\n    except Exception:\n        msgs = [{\"role\": \"user\",\n                 \"content\": f\"{SYSTEM_PROMPT}\\n\\nHeadline: {headline}\\nCompany: {entity}\\nSentiment:\"}]\n        return tokenizer.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)\n\ndef extract_label(text):\n    \"\"\"Extract positive/negative/neutral from model output.\"\"\"\n    t = text.lower().strip()\n    for lbl in [\"positive\", \"negative\", \"neutral\"]:\n        if t.startswith(lbl) or lbl in t:\n            return lbl\n    return \"neutral\"   # safe default\n\ndef evaluate_generative(model, tokenizer, df, split_label, batch_size=8):\n    \"\"\"Run batched inference and compute Accuracy + F1.\"\"\"\n    model.eval()\n    tokenizer.padding_side = \"left\"   # left-pad for generation\n    all_preds, all_labels = [], df[\"label\"].tolist()\n    t0 = time.time()\n\n    for i in range(0, len(df), batch_size):\n        b       = df.iloc[i:i+batch_size]\n        prompts = [make_inference_prompt(r[\"headline\"], r[\"entity\"], tokenizer)\n                   for _, r in b.iterrows()]\n        inputs  = tokenizer(\n            prompts, return_tensors=\"pt\",\n            padding=True, truncation=True, max_length=120\n        ).to(\"cuda\")\n\n        with torch.no_grad():\n            out = model.generate(\n                **inputs,\n                max_new_tokens=5,\n                do_sample=False,\n                pad_token_id=tokenizer.pad_token_id or tokenizer.eos_token_id,\n                eos_token_id=tokenizer.eos_token_id\n            )\n\n        il = inputs[\"input_ids\"].shape[1]\n        for seq in out:\n            decoded = tokenizer.decode(seq[il:], skip_special_tokens=True)\n            all_preds.append(extract_label(decoded))\n\n        if i % (batch_size * 20) == 0:\n            print(f\"  Eval progress: {min(i+batch_size, len(df))}/{len(df)}\")\n\n    ms     = (time.time() - t0) * 1000 / len(df)\n    pred_i = [LABEL2ID.get(p, 2) for p in all_preds]\n    lab_i  = [LABEL2ID.get(l, 2) for l in all_labels]\n\n    acc    = accuracy_score(lab_i, pred_i)\n    mf1    = f1_score(lab_i, pred_i, average=\"macro\",      zero_division=0)\n    per_f1 = f1_score(lab_i, pred_i, average=None, labels=[0,1,2], zero_division=0)\n\n    print(f\"\\n{'='*55}\")\n    print(f\"[{split_label}]\")\n    print(f\"  Accuracy : {acc:.4f}\")\n    print(f\"  Macro F1 : {mf1:.4f}\")\n    print(f\"  Pos F1={per_f1[0]:.4f} | Neg F1={per_f1[1]:.4f} | Neu F1={per_f1[2]:.4f}\")\n    print(f\"  Speed    : {ms:.1f} ms/sample\")\n    print(classification_report(\n        lab_i, pred_i,\n        target_names=[\"positive\", \"negative\", \"neutral\"],\n        zero_division=0\n    ))\n\n    return {\n        \"model\":        split_label,\n        \"accuracy\":     round(acc, 4),\n        \"macro_f1\":     round(mf1, 4),\n        \"pos_f1\":       round(per_f1[0], 4),\n        \"neg_f1\":       round(per_f1[1], 4),\n        \"neu_f1\":       round(per_f1[2], 4),\n        \"inference_ms\": round(ms, 2)\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-03T13:24:55.806481Z","iopub.execute_input":"2026-08-03T13:24:55.806793Z","iopub.status.idle":"2026-08-03T13:24:55.820804Z","shell.execute_reply.started":"2026-08-03T13:24:55.806771Z","shell.execute_reply":"2026-08-03T13:24:55.820066Z"}},"outputs":[],"execution_count":4},{"id":"4fa2d4aa-2131-414f-9412-a9e40a12a621","cell_type":"code","source":"# ── STEP 5: LoRA Training function  ───────────────────────────────────\ndef train_lora(model_path, short_name):\n    \"\"\"LoRA (fp16, no quantization) — for 3B models on T4.\"\"\"\n    print(f\"\\n{'='*60}\\nLoRA: {short_name}\\n{'='*60}\")\n\n    # Tokenizer\n    tok = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)\n    if tok.pad_token is None:\n        tok.pad_token    = tok.eos_token\n        tok.pad_token_id = tok.eos_token_id\n    tok.padding_side = \"right\"   # right-pad during training\n\n    # Model in fp16 — T4 has native fp16 Tensor Cores\n    model = AutoModelForCausalLM.from_pretrained(\n        model_path,\n        torch_dtype=torch.float16,\n        device_map=\"auto\",\n        trust_remote_code=True\n    )\n\n    # LoRA adapter\n    lora_cfg = LoraConfig(\n        r=16, lora_alpha=32,\n        target_modules=[\"q_proj\",\"k_proj\",\"v_proj\",\"o_proj\",\n                        \"gate_proj\",\"up_proj\",\"down_proj\"],\n        lora_dropout=0.05,\n        bias=\"none\",\n        task_type=TaskType.CAUSAL_LM\n    )\n    model = get_peft_model(model, lora_cfg)\n    model.print_trainable_parameters()\n\n    # Format training data\n    texts = [\n        {\"text\": make_training_text(r[\"headline\"], r[\"entity\"], r[\"label\"], tok)}\n        for _, r in train_df.iterrows()\n    ]\n\n    # Train — SFTConfig is the correct API for TRL 1.x\n    SFTTrainer(\n        model=model,\n        args=SFTConfig(\n            output_dir=f\"{SAVE_DIR}/{short_name}\",\n            dataset_text_field=\"text\",   # which column has training text\n            max_length=128,\n            packing=False,\n            loss_type=\"nll\",          # fix: skip chunked_nll patch that breaks PEFT\n            num_train_epochs=3,\n            per_device_train_batch_size=4,\n            gradient_accumulation_steps=8,   # effective batch = 32\n            learning_rate=2e-4,\n            lr_scheduler_type=\"cosine\",\n            warmup_steps=50,\n            fp16=True,    # T4: fp16 ✅  (bf16 not natively supported on T4)\n            bf16=False,\n            logging_steps=25,\n            save_strategy=\"no\",\n            optim=\"adamw_torch\",\n            report_to=\"none\",\n            gradient_checkpointing=True,\n            gradient_checkpointing_kwargs={\"use_reentrant\": False},\n        ),\n        train_dataset=Dataset.from_list(texts),\n        processing_class=tok,   # TRL 1.x: processing_class replaces tokenizer\n    ).train()\n\n    # Save LoRA adapter\n    model.save_pretrained(f\"{SAVE_DIR}/{short_name}_adapter\")\n    tok.save_pretrained(f\"{SAVE_DIR}/{short_name}_adapter\")\n    print(f\"Adapter saved → {SAVE_DIR}/{short_name}_adapter\")\n\n    # Evaluate\n    tok.padding_side = \"left\"   # left-pad for generation\n    val_res  = evaluate_generative(model, tok, val_df,  f\"{short_name}_val\")\n    test_res = evaluate_generative(model, tok, test_df, f\"{short_name}_test\")\n\n    del model, tok\n    gc.collect()\n    torch.cuda.empty_cache()\n    print(f\"✅ {short_name} complete — GPU cleared\")\n    return val_res, test_res","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-03T13:24:55.822698Z","iopub.execute_input":"2026-08-03T13:24:55.823004Z","iopub.status.idle":"2026-08-03T13:24:55.838218Z","shell.execute_reply.started":"2026-08-03T13:24:55.822973Z","shell.execute_reply":"2026-08-03T13:24:55.837423Z"}},"outputs":[],"execution_count":5},{"id":"90512be5-7cd8-43b5-bd8d-9bffce2d065d","cell_type":"code","source":"# ── STEP 7: Train Gemma-2-2B-it  [LoRA, ~1.5 hrs]  ──────────────────\nprint(\"\\n\" + \"=\"*60)\nprint(\"MODEL 1: Gemma-2-2B-it  [LoRA]  ~1.5 hrs\")\nprint(\"=\"*60)\n\nvr, tr = train_lora(\"google/gemma-2-2b-it\", \"Gemma-2-2B\")\nRESULTS.extend([vr, tr])\n\nprint(\"\\nGemma-2-2B interim results:\")\nprint(pd.DataFrame([vr, tr]).to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-03T15:01:40.044865Z","iopub.execute_input":"2026-08-03T15:01:40.045546Z","iopub.status.idle":"2026-08-03T16:24:26.840663Z","shell.execute_reply.started":"2026-08-03T15:01:40.045517Z","shell.execute_reply":"2026-08-03T16:24:26.839931Z"}},"outputs":[{"name":"stdout","text":"\n============================================================\nMODEL 1: Gemma-2-2B-it  [LoRA]  ~1.5 hrs\n============================================================\n\n============================================================\nLoRA: Gemma-2-2B\n============================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/288 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"35cfa8eb54b14dbea