    "from mlx_lm import load, generate\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_MLX     = str(Path.home() / \"Desktop/Qwen2.5-3B-MLX-fp16\")\n",
    "ADAPTER_PATH = str(Path.home() / \"Desktop/sentiment-drl-trading/finetune_llm/Qwen2.5-3B-SEntFiN-LoRA-HPtuned\")\n",
    "\n",
    "print(\"Loading on Apple Silicon GPU...\")\n",
    "model, tok = load(BASE_MLX, adapter_path=ADAPTER_PATH)\n",
    "print(\"✅ Ready\\n\")\n",
    "\n",
    "SYSTEM_PROMPT = (\n",
    "    \"You are a financial sentiment analyst. Given a news headline and a company name, \"\n",
    "    \"classify the sentiment towards that company. \"\n",
    "    \"Reply with exactly one word: positive, negative, or neutral.\"\n",
    ")\n",
    "\n",
    "def predict(headline, company):\n",
    "    prompt = f\"\"\"<|im_start|>system\n",
    "{SYSTEM_PROMPT}<|im_end|>\n",
    "<|im_start|>user\n",
    "Headline: {headline}\n",
    "Company: {company}\n",
    "Sentiment:<|im_end|>\n",
    "<|im_start|>assistant\n",
    "\"\"\"\n",
    "    out = generate(model, tok, prompt=prompt, max_tokens=5, verbose=False)\n",
    "    for lbl in [\"positive\", \"negative\", \"neutral\"]:\n",
    "        if lbl in out.lower():\n",
    "            return lbl\n",
    "    return \"neutral\"\n",
    "\n",
    "# Tests\n",
    "tests = [\n",
    "    (\"TCS opens new AI lab in Bengaluru with Nvidia\",     \"TCS\",      \"positive/neutral\"),\n",
    "    (\"Infosys expands to 3 new cities in Southeast Asia\", \"Infosys\",  \"positive/neutral\"),\n",
    "    (\"Wipro bags 300 million dollar cloud deal\",          \"Wipro\",    \"positive\"),\n",
    "    (\"Reliance posts record quarterly profit\",            \"Reliance\", \"positive\"),\n",
    "    (\"Infosys cuts revenue forecast amid slowdown\",       \"Infosys\",  \"negative\"),\n",
    "    (\"TCS reports steep decline in net profit\",           \"TCS\",      \"negative\"),\n",
    "    (\"Stock falls 8 percent after weak earnings\",         \"Stock\",    \"negative\"),\n",
    "]\n",
    "\n",
    "print(f\"{'':3}{'Headline':<56} {'Company':<10} {'Expected':<20} {'Got'}\")\n",
    "print(\"─\"*100)\n",
    "passed = 0\n",
    "for headline, company, expected in tests:\n",
    "    pred = predict(headline, company)\n",
    "    ok   = pred in expected.split(\"/\")\n",
    "    if ok: passed += 1\n",
    "    print(f\"{'✅' if ok else '❌'}  {headline[:54]:<56} {company:<10} {expected:<20} {pred}\")\n",
    "print(f\"\\nScore: {passed}/{len(tests)}\")\n",
    "\n",
    "# Interactive\n",
    "print(\"\\nInteractive (Ctrl+C to quit)\")\n",
    "while True:\n",
    "    try:\n",
    "        h = input(\"\\nHeadline : \").strip()\n",
    "        if not h: continue\n",
    "        c = input(\"Company  : \").strip() or \"Company\"\n",
    "        print(f\"→ {predict(h, c).upper()}\")\n",
    "    except KeyboardInterrupt:\n",
    "        print(\"\\nDone!\")\n",
    "        break"
   ]
