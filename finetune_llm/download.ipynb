   "source": [
    "# fix_adapter.py — run this once to fix the MLX adapter\n",
    "import json\n",
    "import torch\n",
    "from pathlib import Path\n",
    "from safetensors.torch import load_file, save_file\n",
    "\n",
    "PEFT_PATH   = Path.home() / \"Desktop/sentiment-drl-trading/finetune_llm/Qwen2.5-3B-SEntFiN-LoRA-HPtuned\"\n",
    "MLX_BASE    = Path.home() / \"Desktop/Qwen2.5-3B-MLX-fp16\"\n",
    "MLX_ADAPTER = MLX_BASE / \"mlx_adapters\"\n",
    "MLX_ADAPTER.mkdir(exist_ok=True)\n",
    "\n",
    "# Load PEFT config\n",
    "with open(PEFT_PATH / \"adapter_config.json\") as f:\n",
    "    peft_cfg = json.load(f)\n",
    "\n",
    "rank  = peft_cfg[\"r\"]          # 32\n",
    "alpha = peft_cfg[\"lora_alpha\"] # 128\n",
    "scale = alpha / rank            # 4.0\n",
    "print(f\"rank={rank} | alpha={alpha} | scale={scale}\")\n",
    "\n",
    "# Load PEFT weights\n",
    "peft_weights = load_file(str(PEFT_PATH / \"adapter_model.safetensors\"))\n",
    "print(f\"PEFT adapter keys: {len(peft_weights)}\")\n",
    "\n",
    "# Convert keys + transpose weights\n",
    "mlx_weights = {}\n",
    "for key, tensor in peft_weights.items():\n",
    "    if \"lora_A.weight\" in key:\n",
    "        # PEFT lora_A: shape (rank, in_features)\n",
    "        # MLX  lora_a: shape (in_features, rank)  ← transposed\n",
    "        new_key = key.replace(\"base_model.model.\", \"\").replace(\".lora_A.weight\", \".lora_a\")\n",
    "        mlx_weights[new_key] = tensor.T.contiguous().float()\n",
    "        \n",
    "    elif \"lora_B.weight\" in key:\n",
    "        # PEFT lora_B: shape (out_features, rank)\n",
    "        # MLX  lora_b: shape (rank, out_features) ← transposed\n",
    "        new_key = key.replace(\"base_model.model.\", \"\").replace(\".lora_B.weight\", \".lora_b\")\n",
    "        mlx_weights[new_key] = tensor.T.contiguous().float()\n",
    "\n",
    "print(f\"MLX adapter keys: {len(mlx_weights)}\")\n",
    "print(\"Sample keys:\")\n",
    "for k in list(mlx_weights.keys())[:4]:\n",
    "    print(f\"  {k}  {mlx_weights[k].shape}\")\n",
    "\n",
    "# Save\n",
    "save_file(mlx_weights, str(MLX_ADAPTER / \"adapters.safetensors\"))\n",
    "\n",
    "# MLX adapter config — Qwen2.5-3B has 36 layers\n",
    "mlx_cfg = {\n",
    "    \"fine_tune_type\": \"lora\",\n",
    "    \"num_layers\": 36,\n",
    "    \"lora_parameters\": {\n",
    "        \"rank\": rank,\n",
    "        \"alpha\": float(alpha),\n",
    "        \"scale\": scale,\n",
    "        \"dropout\": 0.0,\n",
    "        \"keys\": [\n",
    "            \"self_attn.q_proj\",\n",
    "            \"self_attn.k_proj\",\n",
    "            \"self_attn.v_proj\",\n",
    "            \"self_attn.o_proj\",\n",
    "            \"mlp.gate_proj\",\n",
    "            \"mlp.up_proj\",\n",
    "            \"mlp.down_proj\"\n",
    "        ]\n",
    "    }\n",
    "}\n",
    "\n",
    "with open(MLX_ADAPTER / \"adapter_config.json\", \"w\") as f:\n",
    "    json.dump(mlx_cfg, f, indent=2)\n",
    "\n",
    "print(f\"\\n✅ Fixed adapter saved to {MLX_ADAPTER}\")\n",
    "print(\"Now run predict_mlx.py\")"
   ]
