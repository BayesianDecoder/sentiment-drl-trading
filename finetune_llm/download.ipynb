    "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
    "from peft import PeftModel\n",
    "import torch, os\n",
    "from pathlib import Path\n",
    "\n",
    "# ── Use Path object — fixes the HF validation error ───────────────────\n",
    "ADAPTER_PATH = Path.home() / \"/Users/vijay/Desktop/sentiment-drl-trading/finetune_llm/Qwen2.5-3B-SEntFiN-LoRA-HPtuned\"\n",
    "MERGED_PATH  = Path.home() / \"/Users/vijay/Desktop/sentiment-drl-trading/finetune_llm/Qwen2.5-3B-SEntFiN-MERGED\"\n",
    "BASE_MODEL   = \"Qwen/Qwen2.5-3B-Instruct\"\n",
    "\n",
    "print(f\"Adapter path exists: {ADAPTER_PATH.exists()}\")  # should print True\n",
    "print(f\"Files: {list(ADAPTER_PATH.iterdir())}\")\n",
    "\n",
    "print(\"\\nLoading tokenizer...\")\n",
    "tok = AutoTokenizer.from_pretrained(str(ADAPTER_PATH), local_files_only=True)  # ← local_files_only\n",
    "\n",
    "print(\"Loading base model (downloads ~6GB first time)...\")\n",
    "base = AutoModelForCausalLM.from_pretrained(\n",
    "    BASE_MODEL,\n",
    "    dtype=torch.float16,\n",
    "    device_map=\"mps\"    # Apple Silicon — change to \"cpu\" if issues\n",
    ")\n",
    "\n",
    "print(\"Loading adapter...\")\n",
    "model = PeftModel.from_pretrained(base, str(ADAPTER_PATH), local_files_only=True)\n",
    "\n",
    "print(\"Merging...\")\n",
    "merged = model.merge_and_unload()\n",
    "\n",
    "print(f\"Saving to {MERGED_PATH} ...\")\n",
    "MERGED_PATH.mkdir(parents=True, exist_ok=True)\n",
    "merged.save_pretrained(str(MERGED_PATH))\n",
    "tok.save_pretrained(str(MERGED_PATH))\n",
    "print(\"✅ Merged model saved\")"
   ]
  },
