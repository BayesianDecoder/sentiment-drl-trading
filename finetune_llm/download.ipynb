    "# predict_mlx.py\n",
    "from mlx_lm import load, generate\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_MLX    = str(Path.home() / \"Desktop/Qwen2.5-3B-MLX-fp16\")\n",
    "MLX_ADAPTER = str(Path.home() / \"Desktop/Qwen2.5-3B-MLX-fp16/mlx_adapters\")\n",
    "\n",
    "print(\"Loading on Apple Silicon GPU...\")\n",
    "model, tok = load(BASE_MLX, adapter_path=MLX_ADAPTER)\n",
    "print(\"✅ Ready\\n\")\n",
    "\n",
    "SYSTEM_PROMPT = (\n",
    "    \"You are a financial sentiment analyst. Given a news headline and a company name, \"\n",
    "    \"classify the sentiment towards that company. \"\n",
    "    \"Reply with exactly one word: positive, negative, or neutral.\"\n",
    ")\n",
    "\n",
    "def predict(headline, company):\n",
    "    prompt = f\"\"\"<|im_start|>system\n",
    "{SYSTEM_PROMPT}<|im_end|>\n",
    "<|im_start|>user\n",
    "Headline: {headline}\n",
    "Company: {company}\n",
    "Sentiment:<|im_end|>\n",
    "<|im_start|>assistant\n",
    "\"\"\"\n",
    "    out = generate(model, tok, prompt=prompt, max_tokens=5, verbose=False)\n",
    "    for lbl in [\"positive\", \"negative\", \"neutral\"]:\n",
    "        if lbl in out.lower():\n",
    "            return lbl\n",
    "    return \"neutral\"\n",
    "\n",
    "tests = [\n",
    "    (\"TCS opens new AI lab in Bengaluru with Nvidia\",     \"TCS\"),\n",
    "    (\"Infosys cuts revenue forecast amid slowdown\",       \"Infosys\"),\n",
    "    (\"Reliance posts record quarterly profit\",            \"Reliance\"),\n",
    "    (\"Wipro bags 300 million dollar cloud deal\",          \"Wipro\"),\n",
    "    (\"Stock falls after weak quarterly earnings\",         \"Stock\"),\n",
    "]\n",
    "\n",
    "print(f\"{'Headline':<55} {'Company':<12} Sentiment\")\n",
    "print(\"-\"*80)\n",
