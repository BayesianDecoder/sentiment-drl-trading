   "source": [
    "# predict.py — Run Qwen2.5-3B SEntFiN locally\n",
    "# ─────────────────────────────────────────────\n",
    "# Adapter is already on your machine.\n",
    "# Base model (~6GB) will download from HF on first run, then cached.\n",
    "\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n",
    "from peft import PeftModel\n",
    "import torch\n",
    "import os\n",
    "\n",
    "# ── Paths ─────────────────────────────────────────────────────\n",
    "ADAPTER_PATH = os.path.expanduser(\n",
    "    \"~/Desktop/sentiment-drl-trading/finetuned/Qwen2.5-3B-SEntFiN-LoRA-HPtuned\"\n",
    ")\n",
    "BASE_MODEL = \"Qwen/Qwen2.5-3B-Instruct\"\n",
    "\n",
    "# ── Detect hardware ───────────────────────────────────────────\n",
    "if torch.cuda.is_available():\n",
    "    VRAM_GB = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)} | VRAM: {VRAM_GB:.1f} GB\")\n",
    "    USE_GPU   = True\n",
    "    USE_4BIT  = VRAM_GB < 8   # use 4-bit if less than 8GB VRAM\n",
    "elif torch.backends.mps.is_available():\n",
    "    print(\"Apple Silicon MPS detected\")\n",
    "    USE_GPU   = True\n",
    "    USE_4BIT  = False\n",
    "else:\n",
    "    print(\"No GPU found — running on CPU (slow but works)\")\n",
    "    USE_GPU   = False\n",
    "    USE_4BIT  = False\n",
    "\n",
    "# ── Load model ────────────────────────────────────────────────\n",
    "print(f\"\\nLoading base model (downloads ~6GB on first run)...\")\n",
    "print(f\"4-bit quantization: {USE_4BIT}\")\n",
    "\n",
    "if USE_4BIT:\n",
    "    bnb_config = BitsAndBytesConfig(\n",
    "        load_in_4bit=True,\n",
    "        bnb_4bit_quant_type=\"nf4\",\n",
    "        bnb_4bit_compute_dtype=torch.float16,\n",
    "    )\n",
    "    base = AutoModelForCausalLM.from_pretrained(\n",
    "        BASE_MODEL,\n",
    "        quantization_config=bnb_config,\n",
    "        device_map=\"auto\",\n",
    "        trust_remote_code=True\n",
    "    )\n",
    "elif USE_GPU:\n",
    "    base = AutoModelForCausalLM.from_pretrained(\n",
    "        BASE_MODEL,\n",
    "        torch_dtype=torch.float16,\n",
    "        device_map=\"auto\",\n",
    "        trust_remote_code=True\n",
    "    )\n",
    "else:\n",
    "    # CPU — use float32\n",
    "    base = AutoModelForCausalLM.from_pretrained(\n",
    "        BASE_MODEL,\n",
    "        torch_dtype=torch.float32,\n",
    "        device_map=\"cpu\",\n",
    "        trust_remote_code=True\n",
    "    )\n",
    "\n",
    "# Load adapter from local path\n",
    "tok   = AutoTokenizer.from_pretrained(ADAPTER_PATH)\n",
    "model = PeftModel.from_pretrained(base, ADAPTER_PATH)\n",
    "model.eval()\n",
    "print(\"✅ Model ready\\n\")\n",
    "\n",
    "# ── Inference ─────────────────────────────────────────────────\n",
    "SYSTEM_PROMPT = (\n",
    "    \"You are a financial sentiment analyst. Given a news headline and a company name, \"\n",
    "    \"classify the sentiment towards that company. \"\n",
    "    \"Reply with exactly one word: positive, negative, or neutral.\"\n",
    ")\n",
    "\n",
    "DEVICE = next(model.parameters()).device\n",
    "\n",
    "def predict_sentiment(headline, company):\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
    "        {\"role\": \"user\",   \"content\": f\"Headline: {headline}\\nCompany: {company}\\nSentiment:\"}\n",
    "    ]\n",
    "    prompt = tok.apply_chat_template(\n",
    "        messages, tokenize=False, add_generation_prompt=True\n",
    "    )\n",
    "    inputs = tok(\n",
    "        prompt, return_tensors=\"pt\", truncation=True, max_length=120\n",
    "    ).to(DEVICE)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        out = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=5,\n",
    "            do_sample=False,\n",
    "            pad_token_id=tok.pad_token_id or tok.eos_token_id,\n",
    "        )\n",
    "\n",
    "    new_tokens = out[0][inputs[\"input_ids\"].shape[1]:]\n",
    "    raw = tok.decode(new_tokens, skip_special_tokens=True).lower().strip()\n",
    "\n",
    "    for lbl in [\"positive\", \"negative\", \"neutral\"]:\n",
    "        if raw.startswith(lbl) or lbl in raw:\n",
    "            return lbl, raw\n",
    "    return \"neutral\", raw\n",
    "\n",
    "def predict_batch(pairs):\n",
    "    \"\"\"\n",
    "    pairs: list of (headline, company) tuples\n",
    "    Returns: list of sentiment strings\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    for headline, company in pairs:\n",
    "        sentiment, _ = predict_sentiment(headline, company)\n",
    "        results.append(sentiment)\n",
    "    return results\n",
    "\n",
    "# ── Test cases ────────────────────────────────────────────────\n",
    "if __name__ == \"__main__\":\n",
    "    test_cases = [\n",
    "        # Corporate actions — FinBERT failure zone\n",
    "        (\"TCS opens new AI lab in Bengaluru with Nvidia\",          \"TCS\"),\n",
    "        (\"Infosys expands operations to 3 new cities\",             \"Infosys\"),\n",
    "        (\"Wipro bags 300 million dollar cloud deal\",               \"Wipro\"),\n",
    "        (\"Company launches new AI-powered product line\",            \"Company\"),\n",
    "        (\"HCL partners with Microsoft for cloud transformation\",   \"HCL\"),\n",
    "        # Controls — clear signals\n",
    "        (\"Infosys cuts revenue forecast amid global slowdown\",     \"Infosys\"),\n",
    "        (\"Reliance posts record quarterly profit of 20000 crore\",  \"Reliance\"),\n",
    "        (\"Stock falls 8 percent after weak earnings\",              \"Stock\"),\n",
    "        (\"TCS reports steep decline in net profit\",                \"TCS\"),\n",
    "        (\"Wipro beats analyst estimates with strong Q3 results\",   \"Wipro\"),\n",
    "    ]\n",
    "\n",
    "    print(f\"{'Headline':<58} {'Company':<10} {'Sentiment'}\")\n",
    "    print(\"-\" * 85)\n",
    "    for headline, company in test_cases:\n",
    "        sentiment, raw = predict_sentiment(headline, company)\n",
    "        marker = \"✅\" if sentiment != \"negative\" or \"decline\" in headline.lower() or \"falls\" in headline.lower() or \"cuts\" in headline.lower() else \"⚠️\"\n",
    "        print(f\"{marker} {headline:<56} {company:<10} {sentiment}\")\n",
    "\n",
    "    print(\"\\n✅ done\")\n",
    "    print(\"\\n── Interactive mode ──\")\n",
    "    print(\"Enter headline and company to test (or Ctrl+C to quit)\\n\")\n",
    "\n",
    "    while True:\n",
    "        try:\n",
    "            headline = input(\"Headline : \").strip()\n",
    "            if not headline:\n",
    "                continue\n",
    "            company  = input(\"Company  : \").strip() or \"Company\"\n",
    "            sentiment, raw = predict_sentiment(headline, company)\n",
    "            print(f\"→ {sentiment.upper()} (raw: '{raw}')\\n\")\n",
    "        except KeyboardInterrupt:\n",
    "            print(\"\\nBye!\")\n",
    "            break"
   ]
  },
