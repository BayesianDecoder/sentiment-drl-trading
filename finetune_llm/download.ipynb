    "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
    "from peft import PeftModel\n",
    "from pathlib import Path\n",
    "import torch, json, time\n",
    "\n",
    "ADAPTER_PATH = Path(\"/Users/vijay/Desktop/sentiment-drl-trading/finetune_llm/Qwen2.5-3B-SEntFiN-LoRA-HPtuned\")\n",
    "\n",
    "with open(ADAPTER_PATH / \"adapter_config.json\") as f:\n",
    "    BASE_MODEL = json.load(f)[\"base_model_name_or_path\"]\n",
    "\n",
    "print(f\"Base: {BASE_MODEL}\")\n",
    "print(f\"Cache: already there ✅ — loading from disk (takes 3-5 min on MPS)\\n\")\n",
    "\n",
    "# ── Load tokenizer ────────────────────────────────────────────────────\n",
    "tok = AutoTokenizer.from_pretrained(str(ADAPTER_PATH))\n",
    "print(\"✅ Tokenizer loaded\")\n",
    "\n",
    "# ── Load base model from cache (no download) ──────────────────────────\n",
    "print(\"Loading base model from disk cache...\")\n",
    "t0   = time.time()\n",
    "base = AutoModelForCausalLM.from_pretrained(\n",
    "    BASE_MODEL,\n",
    "    dtype=torch.float16,\n",
    "    device_map=\"mps\",\n",
    "    local_files_only=True,    # ← force cache, skip any network check\n",
    ")\n",
    "print(f\"✅ Base model loaded in {time.time()-t0:.0f}s\")\n",
    "\n",
    "# ── Load adapter ──────────────────────────────────────────────────────\n",
    "print(\"Loading LoRA adapter...\")\n",
    "model = PeftModel.from_pretrained(\n",
    "    base,\n",
    "    str(ADAPTER_PATH),\n",
    "    local_files_only=True\n",
    ")\n",
    "model.eval()\n",
    "print(\"✅ Model ready\\n\")\n",
    "\n",
    "# ── Predict ───────────────────────────────────────────────────────────\n",
    "SYSTEM_PROMPT = (\n",
    "    \"You are a financial sentiment analyst. Given a news headline and a company name, \"\n",
    "    \"classify the sentiment towards that company. \"\n",
    "    \"Reply with exactly one word: positive, negative, or neutral.\"\n",
    ")\n",
    "\n",
    "def predict(headline, company):\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
    "        {\"role\": \"user\",   \"content\": f\"Headline: {headline}\\nCompany: {company}\\nSentiment:\"}\n",
    "    ]\n",
    "    prompt = tok.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
    "    inputs = tok(prompt, return_tensors=\"pt\", truncation=True, max_length=120).to(model.device)\n",
    "    with torch.no_grad():\n",
    "        out = model.generate(\n",
    "            **inputs, max_new_tokens=5, do_sample=False,\n",
    "            pad_token_id=tok.pad_token_id or tok.eos_token_id\n",
    "        )\n",
    "    raw = tok.decode(out[0][inputs[\"input_ids\"].shape[1]:], skip_special_tokens=True).lower().strip()\n",
    "    for lbl in [\"positive\", \"negative\", \"neutral\"]:\n",
    "        if raw.startswith(lbl) or lbl in raw:\n",
    "            return lbl\n",
    "    return \"neutral\"\n",
    "\n",
    "# ── Tests ─────────────────────────────────────────────────────────────\n",
    "tests = [\n",
    "    (\"TCS opens new AI lab in Bengaluru with Nvidia\",          \"TCS\",      \"positive/neutral\"),\n",
    "    (\"Infosys expands to 3 new cities across Southeast Asia\",  \"Infosys\",  \"positive/neutral\"),\n",
    "    (\"Wipro bags 300 million dollar cloud deal\",               \"Wipro\",    \"positive\"),\n",
    "    (\"HCL partners with Microsoft for cloud transformation\",   \"HCL\",      \"positive/neutral\"),\n",
    "    (\"Reliance posts record quarterly profit of 20000 crore\",  \"Reliance\", \"positive\"),\n",
    "    (\"Wipro beats analyst estimates with strong Q3 results\",   \"Wipro\",    \"positive\"),\n",
    "    (\"Infosys cuts annual revenue forecast amid slowdown\",     \"Infosys\",  \"negative\"),\n",
    "    (\"TCS reports steep decline in net profit\",                \"TCS\",      \"negative\"),\n",
    "    (\"Stock falls 8 percent after weak quarterly earnings\",    \"Stock\",    \"negative\"),\n",
    "]\n",
    "\n",
    "print(f\"{'':3}{'Headline':<56} {'Company':<10} {'Expected':<20} {'Got'}\")\n",
    "print(\"─\"*100)\n",
    "passed = 0\n",
    "for headline, company, expected in tests:\n",
    "    pred = predict(headline, company)\n",
    "    ok   = pred in expected.split(\"/\")\n",
    "    if ok: passed += 1\n",
    "    print(f\"{'✅' if ok else '❌'}  {headline[:54]:<56} {company:<10} {expected:<20} {pred}\")\n",
    "\n",
    "print(\"─\"*100)\n",
    "print(f\"Score: {passed}/{len(tests)}  ({100*passed/len(tests):.0f}%)\")\n",
    "\n",
    "# ── Interactive ───────────────────────────────────────────────────────\n",
    "print(\"\\nInteractive (Ctrl+C to quit)\")\n",
    "while True:\n",
    "    try:\n",
    "        h = input(\"\\nHeadline : \").strip()\n",
    "        if not h: continue\n",
    "        c = input(\"Company  : \").strip() or \"Company\"\n",
    "        print(f\"→ {predict(h, c).upper()}\")\n",
    "    except KeyboardInterrupt:\n",
    "        print(\"\\nDone!\")\n",
    "        break"
   ]
  },
