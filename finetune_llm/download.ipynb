    "# convert_adapter.py\n",
    "import json\n",
    "import torch\n",
    "from pathlib import Path\n",
    "from safetensors.torch import load_file, save_file\n",
    "\n",
    "PEFT_PATH    = Path.home() / \"Desktop/sentiment-drl-trading/finetune_llm/Qwen2.5-3B-SEntFiN-LoRA-HPtuned\"\n",
    "MLX_ADAPTER  = Path.home() / \"Desktop/Qwen2.5-3B-MLX-fp16/mlx_adapters\"\n",
    "MLX_ADAPTER.mkdir(exist_ok=True)\n",
    "\n",
    "# Load PEFT config\n",
    "with open(PEFT_PATH / \"adapter_config.json\") as f:\n",
    "    peft_cfg = json.load(f)\n",
    "\n",
    "rank  = peft_cfg[\"r\"]\n",
    "alpha = peft_cfg[\"lora_alpha\"]\n",
    "print(f\"rank={rank} | alpha={alpha}\")\n",
    "\n",
    "# Load PEFT weights\n",
    "peft_weights = load_file(str(PEFT_PATH / \"adapter_model.safetensors\"))\n",
    "print(f\"PEFT keys: {len(peft_weights)}\")\n",
    "\n",
    "# Convert keys: PEFT → MLX format\n",
    "# PEFT: base_model.model.model.layers.0.self_attn.q_proj.lora_A.weight\n",
    "# MLX:  model.layers.0.self_attn.q_proj.lora_a.weight\n",
    "mlx_weights = {}\n",
    "for key, tensor in peft_weights.items():\n",
    "    new_key = key\n",
    "    new_key = new_key.replace(\"base_model.model.\", \"\")  # remove PEFT prefix\n",
    "    new_key = new_key.replace(\".lora_A.weight\", \".lora_a.weight\")\n",
    "    new_key = new_key.replace(\".lora_B.weight\", \".lora_b.weight\")\n",
    "    mlx_weights[new_key] = tensor.contiguous()\n",
    "    print(f\"  {key[:60]} → {new_key[:60]}\")\n",
    "\n",
    "# Save MLX adapter weights\n",
    "save_file(mlx_weights, str(MLX_ADAPTER / \"adapters.safetensors\"))\n",
    "\n",
    "# Create MLX adapter config\n",
    "mlx_cfg = {\n",
    "    \"num_layers\": 36,\n",
    "    \"lora_parameters\": {\n",
    "        \"rank\": rank,\n",
    "        \"alpha\": float(alpha),\n",
    "        \"dropout\": 0.0,\n",
    "        \"scale\": float(alpha / rank),\n",
    "        \"keys\": [\n",
    "            \"self_attn.q_proj\",\n",
    "            \"self_attn.k_proj\",\n",
    "            \"self_attn.v_proj\",\n",
    "            \"self_attn.o_proj\",\n",
    "            \"mlp.gate_proj\",\n",
    "            \"mlp.up_proj\",\n",
    "            \"mlp.down_proj\"\n",
    "        ]\n",
    "    },\n",
    "    \"fine_tune_type\": \"lora\"\n",
    "}\n",
    "\n",
    "with open(MLX_ADAPTER / \"adapter_config.json\", \"w\") as f:\n",
    "    json.dump(mlx_cfg, f, indent=2)\n",
    "\n",
    "print(f\"\\n✅ MLX adapter saved to {MLX_ADAPTER}\")"
   ]
  },
